# Redirect www to the main domain so login/localStorage does not split between two websites.
www.grocery-house-manager.com {
    redir https://grocery-house-manager.com{uri} permanent
}

grocery-house-manager.com {
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Noindex authenticated/private workspaces even when SPA fallback is used.
    @privatePages path /houses* /assistant* /admin* /wallet* /profile* /reports* /market* /more* /login* /premium-try* /appearance* /join*
    header @privatePages X-Robots-Tag "noindex, nofollow"

    # Server-rendered public guide pages are indexable without JavaScript.
    handle /guides* {
        reverse_proxy backend:8000
    }

    handle /guides-sitemap.xml {
        reverse_proxy backend:8000
    }

    handle /docs* {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    handle /uploads* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:5173
    }
}
