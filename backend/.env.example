APP_NAME=Grocery House Manager
ENVIRONMENT=development
# Production: paste the DigitalOcean CONNECTION POOL (PgBouncer) URL here,
# not the direct database URL. Keep sslmode=require if DigitalOcean provides it.
DATABASE_URL=postgresql+psycopg2://grocery_user:grocery_password@localhost:5432/grocery_house
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=3
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=8
DB_KEEPALIVES_IDLE_SECONDS=30
DB_KEEPALIVES_INTERVAL_SECONDS=10
DB_KEEPALIVES_COUNT=3
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=

# Stripe subscription payments. Create recurring monthly Prices in Stripe and paste the price IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_FAMILY_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=

# New-user Basic offer: create a Stripe coupon for 65% off, repeating for 2 months,
# create a promotion code for that coupon, and paste the promo_... ID here.
STRIPE_PROMOTION_CODE_BASIC_NEW_USER=
NEW_USER_OFFER_DAYS=14

# Owner/admin access for /admin dashboard. Separate multiple emails with commas.
ADMIN_EMAILS=kp3813294@gmail.com

# Optional: enables live nearby grocery stores, ratings, addresses, and Google Maps links in Household Pro smart suggestions.
# Also lets the backend turn browser latitude/longitude into a postal code when the user leaves postal code blank.
# Requires Google Maps Platform Places API (New); Geocoding API is recommended for postal-code lookup.
GOOGLE_PLACES_API_KEY=

# Optional SMTP for forgot-password verification emails.
# Recommended production setting: configure these using your support email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Grocery House Manager
SMTP_USE_TLS=true

# Gmail/Google Workspace SMTP for password reset emails
# Use a 16-digit Google App Password. Do not use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=kartik_patel_98@grocery-house-manager.com
SMTP_PASSWORD=your_16_digit_google_app_password
# First test with SMTP_FROM_EMAIL equal to SMTP_USERNAME.
# After that works, use support@ only if it is configured as a Gmail send-as address/alias.
SMTP_FROM_EMAIL=kartik_patel_98@grocery-house-manager.com
SMTP_FROM_NAME=Grocery House Manager
SMTP_USE_TLS=true
# Keep true if Docker logs show: OSError [Errno 101] Network is unreachable
SMTP_FORCE_IPV4=true


# Recommended production email fix when Gmail SMTP 587/465 is blocked by server/hosting.
# Resend sends using HTTPS port 443 instead of SMTP.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
# Verify grocery-house-manager.com in Resend first, then use support@.
# For first testing, you may use Resend's allowed onboarding sender if your Resend account permits it.
RESEND_FROM_EMAIL=support@grocery-house-manager.com
RESEND_FROM_NAME=Grocery House Manager

# Grocery market/product integrations
# Open Food Facts is free/open product data for barcode/name lookup. No key needed.
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=GroceryHouseManager/1.0 (support@grocery-house-manager.com)

# Store-specific product lookup from official store pages.
# Serper is the recommended paid fallback because it is simple and inexpensive.
STORE_LOOKUP_WEB_SEARCH_ENABLED=true
SERPER_API_KEY=
# Existing optional alternatives can stay blank if you use Serper.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
JINA_API_KEY=
BRAVE_SEARCH_API_KEY=

# Universal product identity fallback. Open Food Facts remains first; UPCDatabase is used
# only when OFF has no result. Keep this server-side.
UPCDATABASE_API_KEY=
UPCDATABASE_BASE_URL=https://api.upcdatabase.org
UPCDATABASE_TIMEOUT_SECONDS=12

# Nearby grocery stores. Google Places remains supported; Geoapify is the lower-cost
# exact-place fallback/replacement and starts with a generous free tier.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_RADIUS_METERS=8000
GEOAPIFY_MAX_RESULTS=12
GEOAPIFY_TIMEOUT_SECONDS=10

# Instacart Developer Platform. Start with development until Instacart approves production.
# The key is a Bearer API key from the Instacart Developer Dashboard.
INSTACART_API_KEY=
INSTACART_ENVIRONMENT=development
INSTACART_TIMEOUT_SECONDS=15
INSTACART_COUNTRY_CODE=CA

# Optional Apify actor for Canadian grocery price comparison over HTTPS 443.
# Actor: sunny_eternity/canada-grocery-price-comparison
# Best results use Canadian postal code input.
# Supported retailer keys in this app: loblaws, superstore, nofrills, saveon, pricesmart, tnt
APIFY_API_TOKEN=
APIFY_CANADA_PRICE_ACTOR_ID=sunny_eternity/canada-grocery-price-comparison
APIFY_PRICE_OUTPUT_MODE=comparison
APIFY_PRICE_CACHE_HOURS=24
APIFY_PRICE_FORCE_REFRESH_MIN_MINUTES=30
PRODUCT_LOOKUP_STORE_CACHE_HOURS=24
PRODUCT_LOOKUP_UNIVERSAL_CACHE_HOURS=8760
APIFY_PRICE_TIMEOUT_SECONDS=90
MARKET_MAX_COMPARE_ITEMS=12

# Weekly flyer deals by full Canadian postal code. Uses the same APIFY_API_TOKEN.
# Structured flyer rows include merchant, product, price, image and validity dates.
APIFY_FLYER_ACTOR_ID=scrapersdelight/flipp-flyer-digest
FLYER_CACHE_HOURS=168
FLYER_MERCHANT_CACHE_HOURS=168
FLYER_TIMEOUT_SECONDS=120
FLYER_MAX_MERCHANTS=12
FLYER_MAX_RESULTS=1200

# Smart receipt scanning (optional but recommended for production receipt automation)
# Recommended provider: Tabscanner. It accepts JPG/JPEG and PNG receipt images only.
# It returns structured receipt JSON: store, date, line items, discounts, tax, subtotal, total, and payment method.
RECEIPT_OCR_PROVIDER=tabscanner
# Optional production fallback. Recommended test setup after AWS is configured:
# RECEIPT_OCR_FALLBACK_PROVIDER=aws_textract
RECEIPT_OCR_FALLBACK_PROVIDER=
RECEIPT_OCR_FALLBACK_ON_EMPTY=true
RECEIPT_SCAN_REVIEW_REQUIRED=true
RECEIPT_UPLOAD_MAX_MB=20
TABSCANNER_MONTHLY_ACCOUNT_SCAN_CAP=200
TABSCANNER_API_KEY=
TABSCANNER_PROCESS_URL=https://api.tabscanner.com/api/2/process
TABSCANNER_RESULT_URL=https://api.tabscanner.com/api/result
TABSCANNER_REGION=ca
TABSCANNER_DOCUMENT_TYPE=receipt
TABSCANNER_DEFAULT_DATE_PARSING=m/d
TABSCANNER_POLL_INTERVAL_SECONDS=1
TABSCANNER_TIMEOUT_SECONDS=30
TABSCANNER_TOTAL_TIMEOUT_SECONDS=75

# Optional backup receipt scanner if you decide to use Veryfi instead of Tabscanner.
# Set RECEIPT_OCR_PROVIDER=veryfi and fill these values.
VERYFI_CLIENT_ID=
VERYFI_USERNAME=
VERYFI_API_KEY=
VERYFI_API_URL=https://api.veryfi.com/api/v8/partner/documents
VERYFI_TIMEOUT_SECONDS=60

# AWS Textract AnalyzeExpense. Use this as a fallback/benchmark until you verify
# grocery-receipt accuracy against Tabscanner with your own Canadian receipt set.
AWS_TEXTRACT_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ca-central-1
AWS_TEXTRACT_TIMEOUT_SECONDS=30

# TheMealDB recipe search. Key 1 matches the public endpoint:
# https://www.themealdb.com/api/json/v1/1/search.php?s=<search>
# If you later receive a different TheMealDB key, replace 1 here.
THEMEALDB_API_KEY=1
THEMEALDB_TIMEOUT_SECONDS=15

# --- V93 DigitalOcean AI / Kitchen Vision ---
# Create a DigitalOcean Model Access Key and keep it server-side only.
DIGITALOCEAN_AI_ENABLED=false
DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DIGITALOCEAN_INFERENCE_KEY=
DIGITALOCEAN_VISION_MODEL=nemotron-nano-12b-v2-vl
DIGITALOCEAN_VISION_TIMEOUT_SECONDS=75

# Optional DigitalOcean Agent Platform connector.
DIGITALOCEAN_AGENT_ENABLED=false
DIGITALOCEAN_AGENT_URL=
DIGITALOCEAN_AGENT_ACCESS_KEY=
DIGITALOCEAN_AGENT_TIMEOUT_SECONDS=60

KITCHEN_VISION_ENABLED=true
KITCHEN_VISION_ALLOW_VIDEO=true
KITCHEN_VISION_MAX_VIDEO_SECONDS=30
KITCHEN_VISION_MAX_FILES=6
KITCHEN_VISION_MAX_FRAMES=10
KITCHEN_VISION_UPLOAD_MAX_MB=40
KITCHEN_VISION_REQUIRE_APPROVAL=true
KITCHEN_MEDIA_DELETE_AFTER_ANALYSIS=true

# Optional private DigitalOcean Spaces storage. Not required for ephemeral scans.
DO_SPACES_ENABLED=false
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=tor1
DO_SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com

# --- V98 Food Tonight / nearby restaurant & food-store suggestions ---
# Reuses GOOGLE_PLACES_API_KEY above. No Instacart/Uber/DoorDash key is required.
# Keep this true to enable suggestion-only nearby discovery.
FOOD_PLACES_ENABLED=true
FOOD_PLACES_RADIUS_METERS=8000
FOOD_PLACES_MAX_RESULTS=8
FOOD_PLACES_CACHE_MINUTES=30
FOOD_MENU_FETCH_TIMEOUT_SECONDS=10

# V136: household paid provider request safety (cached results unlimited)
TRIP_PROVIDER_DAILY_LIMIT=4
TRIP_PROVIDER_MONTHLY_LIMIT=30

# V140 House Credits. Only receipt_4 (200 cents) and receipt_10 (400 cents)
# have default CA-dollar prices from the existing receipt packs. Other packs
# stay disabled until you review costs and configure their price explicitly.
# Example (EDIT THESE RATES BEFORE ENABLE):
# GHM_HOUSE_CREDIT_PACK_PRICES_CENTS={"grocery_3":249,"grocery_8":599,"lookup_25":199,"lookup_75":499,"ask_25":249,"ask_75":599,"vision_2":299,"vision_5":699,"price_3":399,"price_8":899}
# Optional estimated provider CAD cost per invocation; source of truth is
# actual vendor billing. Missing costs display as "not configured" in admin.
# GHM_ESTIMATED_UNIT_COST_CAD={"receipt_scan":0.15,"grocery_scan":0.08,"ask_ghm":0.02,"product_lookup":0.01,"kitchen_vision":0.12,"paid_provider":0.35}
# IMPORTANT: STRIPE_WEBHOOK_SECRET=whsec_... is now mandatory for verified billing events.

# V141 · Household credits wallet and branded promotional email
# 1 credit = CA$1, available packs 4, 10, or 20 credits; personal or direct-to-house checkout.
# Fixed exchange rates: 4 receipt scans = 2 credits; 10 receipt scans = 4 credits.
# Additional redemption rates ONLY after validating actual provider costs; whole numbers >=1.
# GHM_CREDIT_REDEMPTION_RATES={"grocery_3":2,"lookup_25":2,"ask_25":3,"vision_2":3,"price_3":4}
# Recommended: configure the legal business postal mailing address before sending marketing offers.
# Required for the admin promotional-email Send action; don't use a made-up address.
# GHM_BUSINESS_MAILING_ADDRESS=Your official business postal address, City, Province, Postal Code, Canada

# V142: GHM Token top-up prices and service exchange rates are edited in Admin > Credit Pricing Manager.
# Settings are stored in the `ghm_credit_pack_pricing` database table; no backend restart is necessary.
# The old GHM_HOUSE_CREDIT_PACK_PRICES_CENTS setting is retained only for fulfilment of earlier
# direct-pack payment sessions, not for new token-based purchases.
# GHM_CREDIT_REDEMPTION_RATES remains a fallback until the admin saves a rate in the database.
