  ],
  "theme_color": "#173b2f",
  "background_color": "#f4f7fb",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "categories": ["shopping", "lifestyle", "productivity"]
}
